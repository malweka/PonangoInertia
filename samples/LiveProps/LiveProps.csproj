<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Ponango.Inertia/Ponango.Inertia.csproj" />
    <ProjectReference Include="../../src/Ponango.Inertia.SignalR/Ponango.Inertia.SignalR.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The front end has its own npm project; keep it out of the .NET build. -->
    <Content Remove="ClientApp/**" />
    <None Remove="ClientApp/**" />
    <Compile Remove="ClientApp/**" />
  </ItemGroup>
</Project>
