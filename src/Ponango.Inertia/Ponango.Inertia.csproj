<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!-- ===== Versioning =====
	     These are the LOCAL DEV DEFAULTS only. CI derives the real version from the git ref and passes
	     -p:Version / -p:FileVersion / -p:AssemblyVersion explicitly (see .github/workflows/release.yml).
	     Nothing here is hand-edited at release time.

	         NuGet version    Version              2.1.0   (or 2.1.0-rc.42 for a candidate)
	         Assembly         AssemblyVersion      2.1.0.42
	         File             FileVersion          2.1.0.42
	         Informational    (derived)            2.1.0+<commit sha>

	     The 4th part is GITHUB_RUN_NUMBER, the CI build number.

	     Tracking the full version in AssemblyVersion is safe HERE because this assembly is not
	     strong-named and .NET (Core) does not enforce AssemblyVersion when binding. It would matter on
	     .NET Framework, or for an assembly loaded dynamically through an AssemblyLoadContext; neither
	     applies to a plain NuGet library reference. Each published NuGet version is immutable, so the
	     build number never varies for a given released version. -->
	<PropertyGroup>
		<VersionPrefix>2.0.0</VersionPrefix>
		<AssemblyVersion>2.0.0.0</AssemblyVersion>
	</PropertyGroup>

	<!-- ===== NuGet package metadata ===== -->
	<PropertyGroup>
		<PackageId>Ponango.Inertia</PackageId>
		<Product>Ponango</Product>
		<Authors>Emmanuel Hameyie</Authors>
		<Copyright>Copyright (C) 2026 Emmanuel Hameyie</Copyright>
		<Description>A server-side adapter for Inertia.js on ASP.NET Core. Build single-page applications with classic server-side routing and controllers, rendering with React, Vue or Svelte on the client. Supports the Inertia v3 protocol: deferred, merged, shared, once and infinite-scroll props that combine freely, rescued deferred props, nested props with dot-notation partial reloads, page-level flash data, big integers as BigInt, history encryption, and precognition.</Description>
		<PackageTags>inertia;inertiajs;aspnetcore;mvc;spa;react;vue;svelte;server-driven</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/malweka/PonangoInertia</PackageProjectUrl>
		<RepositoryUrl>https://github.com/malweka/PonangoInertia.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReleaseNotes>See CHANGELOG.md at the project URL.</PackageReleaseNotes>

		<!-- Off deliberately: the release workflow runs an explicit `dotnet pack`. Leaving this on makes
		     every ordinary build emit a nupkg, which is noise and invites publishing an unintended one. -->
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>

		<!-- Symbols + SourceLink. The .NET 8 SDK includes SourceLink, so no PackageReference is needed.
		     NOTE: the repository is private, so consumers cannot actually fetch sources through it. This
		     costs nothing and starts working the moment the repo goes public. -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<!-- Packed so nuget.org renders the README and the icon on the package page.
		     icon.svg is the source of truth for the mark; icon.png is rendered from it at
		     128x128 and is the file NuGet actually consumes (it accepts PNG/JPEG only). -->
		<None Include="../../README.md" Pack="true" PackagePath="\" />
		<None Include="../../icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
</Project>
