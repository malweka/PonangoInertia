<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!-- Local dev defaults only: CI passes -p:Version / -p:FileVersion / -p:AssemblyVersion, the same values it
	     passes to Ponango.Inertia, so both packages always ship with one version (see release.yml). -->
	<PropertyGroup>
		<VersionPrefix>2.0.0</VersionPrefix>
		<AssemblyVersion>2.0.0.0</AssemblyVersion>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>Ponango.Inertia.SignalR</PackageId>
		<Product>Ponango</Product>
		<Authors>Emmanuel Hameyie</Authors>
		<Copyright>Copyright (C) 2026 Emmanuel Hameyie</Copyright>
		<Description>SignalR support for Inertia.js live props with Ponango.Inertia: a hub that subscribes clients to live channels with per-channel authorization, and a broadcaster that sends live events and prop values. Pairs with the @ponango/inertia-signalr client transport.</Description>
		<PackageTags>inertia;inertiajs;aspnetcore;signalr;live;realtime;websockets</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/malweka/PonangoInertia</PackageProjectUrl>
		<RepositoryUrl>https://github.com/malweka/PonangoInertia.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReleaseNotes>See CHANGELOG.md at the project URL.</PackageReleaseNotes>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="../../icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<!-- The SignalR server is part of the shared framework, so no package dependency is needed for it. -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<ProjectReference Include="../Ponango.Inertia/Ponango.Inertia.csproj" />
	</ItemGroup>
</Project>
